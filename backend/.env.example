# ─── Database Configuration ──────────────────────────────────────────────────
# Option 1: Cloud MySQL or PostgreSQL (Single URL - Recommended for Render)
# DATABASE_URL=mysql://username:password@cloud-mysql-host.com:3306/brandguard_ai

# Option 2: Individual variables (Local MySQL dev or separate cloud parameters)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=brandguard_ai
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# ─── Application & Security ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_this_to_a_long_random_secret_key

# ─── CORS (Allowed Frontend URL on Cloud Hosting) ─────────────────────────────
# Set to your deployed Vercel domain in Render dashboard:
FRONTEND_URL=https://your-brandguard-app.vercel.app

# ─── AI (Optional – leave blank to use deterministic engine) ─────────────────
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=...
